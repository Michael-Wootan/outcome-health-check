# Copy to .env for local runs (never commit .env). In GitHub Actions,
# set these under Settings -> Secrets and variables -> Actions.

# --- Secrets ---
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_your_token_here
AHREFS_API_TOKEN=your-ahrefs-api-v3-token
ANTHROPIC_API_KEY=sk-ant-your-key-here
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_NOTIFY=you@example.com
# Token with Actions read access to the repos being audited
GITHUB_TOKEN=github_pat_your_token_here
EXTRA_REPOS_TOKEN=

# --- Configuration ---
COMPANY_NAME=Acme Supply Co.
SITE_DOMAIN=acmesupply.example
BUSINESS_DESCRIPTION=an e-commerce and B2B wholesale business
# Repo whose workflows are audited, plus optional extra repos (comma-separated)
MONITOR_REPO=your-org/your-automation-repo
EXTRA_REPOS=
WINDOW_DAYS=15
ARTICLES_PER_DAY_TARGET=4
# Order tags that mean a fraud tool is holding an order for review
FRAUD_REVIEW_TAG_PATTERN=nofraud_(error|review)
# Extra instruction for the narrative
NARRATIVE_RULES=Do not make claims the evidence does not support.
# Folder holding the other automations' state files
# STATE_DIR=./state
